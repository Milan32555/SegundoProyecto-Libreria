scalar LocalDateTime

enum Genero {
    FICCION
    NO_FICCION
    CIENCIA
    HISTORIA
    INFANTIL
    POESIA
    OTRO
}

enum EstadoEjemplar {
    DISPONIBLE
    PRESTADO
    DANIADO
    DADO_DE_BAJA
}

"Clase maestro: un título editorial."
type Libro {
    isbn: ID!
    titulo: String!
    autor: String!
    precio: Float!
    numeroPaginas: Int!
    fechaPublicacion: LocalDateTime!
    genero: Genero!
    "Ejemplares físicos de este libro en inventario (0..*)"
    ejemplares: [Ejemplar!]!
}

"Clase detalle: un ejemplar físico concreto de un Libro (1..1 con su libro)."
type Ejemplar {
    codigo: ID!
    estado: EstadoEjemplar!
    ubicacion: String!
    fechaIngreso: LocalDateTime!
    precioReposicion: Float!
    "Veces que se ha prestado este ejemplar (no negativo)"
    numeroPrestamos: Int!
    isbnLibro: String!
    "Libro al que pertenece este ejemplar"
    libro: Libro!
}

"Cuántos ejemplares hay en un estado y qué porcentaje (0 a 100) del inventario representan."
type ConteoEstado {
    estado: EstadoEjemplar!
    cantidad: Int!
    porcentaje: Float!
}

"Resumen del inventario para la ventana principal (lo calcula el servidor)."
type ResumenInventario {
    totalLibros: Int!
    totalEjemplares: Int!
    "Un elemento por cada estado, en el orden del enum (incluye los que tienen 0)"
    ejemplaresPorEstado: [ConteoEstado!]!
}

input LibroInput {
    isbn: ID!
    titulo: String!
    autor: String!
    precio: Float!
    numeroPaginas: Int!
    fechaPublicacion: LocalDateTime!
    genero: Genero!
}

input LibroUpdateInput {
    titulo: String!
    autor: String!
    precio: Float!
    numeroPaginas: Int!
    fechaPublicacion: LocalDateTime!
    genero: Genero!
}

input EjemplarInput {
    codigo: ID!
    estado: EstadoEjemplar!
    ubicacion: String!
    fechaIngreso: LocalDateTime!
    precioReposicion: Float!
    numeroPrestamos: Int!
    isbnLibro: String!
}

input EjemplarUpdateInput {
    estado: EstadoEjemplar!
    ubicacion: String!
    fechaIngreso: LocalDateTime!
    precioReposicion: Float!
    numeroPrestamos: Int!
}

type Query {
    "Listar todos los libros"
    libros: [Libro!]!
    "Listar libros filtrando por autor (contiene, sin tildes) y/o género"
    librosFiltrados(autor: String, genero: Genero): [Libro!]!
    "Cuántos libros cumplen el mismo filtro de librosFiltrados"
    totalLibrosFiltrados(autor: String, genero: Genero): Int!
    "Consultar UN SOLO libro por su ISBN"
    libroPorIsbn(isbn: ID!): Libro
    "Consultar UN SOLO libro por su título exacto (sin distinguir tildes ni mayúsculas)"
    libroPorTitulo(titulo: String!): Libro
    "Aumenta cada vez que la colección de libros cambia (Observer de los clientes)"
    revisionLibros: Int!

    "Listar todos los ejemplares"
    ejemplares: [Ejemplar!]!
    "Listar ejemplares filtrando por estado y/o isbn del libro"
    ejemplaresFiltrados(estado: EstadoEjemplar, isbnLibro: String): [Ejemplar!]!
    "Cuántos ejemplares cumplen el mismo filtro de ejemplaresFiltrados"
    totalEjemplaresFiltrados(estado: EstadoEjemplar, isbnLibro: String): Int!
    "Consultar UN SOLO ejemplar por su código"
    ejemplarPorCodigo(codigo: ID!): Ejemplar
    "Aumenta cada vez que la colección de ejemplares cambia (Observer de los clientes)"
    revisionEjemplares: Int!

    "Resumen del inventario (totales y ejemplares por estado) para la ventana principal"
    resumenInventario: ResumenInventario!
}

type Mutation {
    crearLibro(input: LibroInput!): Libro
    actualizarLibro(isbn: ID!, input: LibroUpdateInput!): Libro
    "Elimina el libro (solo si no tiene ejemplares) y devuelve los datos del libro eliminado"
    eliminarLibro(isbn: ID!): Libro

    crearEjemplar(input: EjemplarInput!): Ejemplar
    actualizarEjemplar(codigo: ID!, input: EjemplarUpdateInput!): Ejemplar
    "Elimina el ejemplar y devuelve los datos del ejemplar eliminado"
    eliminarEjemplar(codigo: ID!): Ejemplar
}
